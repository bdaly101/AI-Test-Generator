{
  "name": "ai-test-generator",
  "version": "1.0.0",
  "description": "CLI tool & GitHub Action that generates Vitest/Jest tests from git diffs using Claude AI. Analyzes code changes, creates unit tests and Supabase Edge Function integration tests, outputs to __tests__/generated/ with TODO markers for review. Supports PR comments or auto-commit to suggestion branches.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ai-test-generator": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/cli/index.ts",
    "lint": "eslint src --ext .ts",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "cli",
    "testing",
    "ai",
    "vitest",
    "jest",
    "code-generation"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@octokit/rest": "^20.0.2",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "handlebars": "^4.7.8",
    "ora": "^8.0.0",
    "simple-git": "^3.22.0",
    "ts-morph": "^22.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
